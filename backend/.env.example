# Backend Environment Variables
# Copy this file to backend/.env and fill in your values

# Database Connection (Required)
# PostgreSQL connection string
# For local development: postgresql://user:password@localhost:5432/kitchenflow
# For Docker: postgresql://kitchenflow:kitchenflow_secret@db:5432/kitchenflow
DATABASE_URL="postgresql://user:password@localhost:5432/kitchenflow"

# Backend Server Configuration (Optional)
BACKEND_PORT=4000
NODE_ENV=development
